    "@types/bcryptjs": "^2.4.6",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.10.1",
    "@types/quill": "^2.0.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "^18.3.2",
    "@types/uuid": "^10.0.0",
    "@vercel/style-guide": "^5.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
