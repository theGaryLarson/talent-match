}

model ProviderTestimonials {
  id            String        @id(clustered: false, map: "provider_testimonials_PRIMARY") @unique(map: "provider_testimonials_id_UNIQUE") @default(dbgenerated("newid()")) @db.UniqueIdentifier
  eduProviderId String        @db.UniqueIdentifier
