generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Subcategory {
  id             String   @id(map: "PK__subcateg__3213E83F064F714D") @default(uuid()) @db.Char(36)
  skill_category String   @db.VarChar(255)
  description    String?  @db.VarChar(255)
  skills         Skill[]
}

model Skill {
  id             String        @id(map: "PK__skills__3213E83FEC93D05F") @default(uuid()) @db.Char(36)
  subcategoryId  String        @db.Char(36)
  skill          String        @unique(map: "UQ_skill") @db.VarChar(255)
  info_url       String?       @db.VarChar(255)
  subcategory    Subcategory   @relation(fields: [subcategoryId], references: [id], onUpdate: NoAction, map: "FK_subcategory_id")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  password       String?
  role           String    @default("JOBSEEKER")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}